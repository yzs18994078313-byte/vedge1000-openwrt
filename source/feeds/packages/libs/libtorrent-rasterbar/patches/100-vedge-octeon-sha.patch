+#ifndef LIBTORRENT_OCTEON_SHA_HPP
+#define LIBTORRENT_OCTEON_SHA_HPP
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <openssl/sha.h>
+
+#if defined(__linux__) && defined(__mips__) && __SIZEOF_POINTER__ == 8 \
+	&& __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define TORRENT_HAS_OCTEON_SHA 1
+#include <cstdlib>
+#include <linux/if_alg.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#else
+#define TORRENT_HAS_OCTEON_SHA 0
+#endif
+
+namespace libtorrent { namespace aux {
+
+// Retain OpenSSL's context layout, partial block handling, and finalization.
+template <typename Context, typename Update, typename Compress>
+int sha_update_blocks(Context& context, unsigned char const* data, std::size_t size,
+	Update update, Compress compress)
+{
+	static_assert(sizeof(SHA_LONG) == sizeof(std::uint32_t), "OpenSSL SHA counter layout");
+	constexpr std::size_t block_size = SHA_CBLOCK;
+	static_assert(block_size == SHA256_CBLOCK, "SHA-1 and SHA-256 block sizes");
+
+	if (context.num != 0 && size != 0)
+	{
+		auto const prefix = (std::min)(size, block_size - context.num);
+		if (!update(&context, data, prefix)) return 0;
+		data += prefix;
+		size -= prefix;
+	}
+
+	auto const blocks = size / block_size;
+	if (blocks != 0)
+	{
+		compress(context, data, blocks);
+		auto const consumed = blocks * block_size;
+		std::uint64_t count = (std::uint64_t(context.Nh) << 32) | context.Nl;
+		count += std::uint64_t(consumed) << 3;
+		context.Nl = static_cast<std::uint32_t>(count);
+		context.Nh = static_cast<std::uint32_t>(count >> 32);
+		data += consumed;
+		size -= consumed;
+	}
+	return size == 0 || update(&context, data, size);
+}
+
+#if TORRENT_HAS_OCTEON_SHA
+inline bool octeon_driver_available(char const* driver)
+{
+	auto const* option = std::getenv("LIBTORRENT_OCTEON_SHA");
+	if (option && std::strcmp(option, "0") == 0) return false;
+
+	int const fd = ::socket(AF_ALG, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+	if (fd < 0) return false;
+	struct sockaddr_alg address = {};
+	address.salg_family = AF_ALG;
+	std::memcpy(address.salg_type, "hash", sizeof("hash"));
+	std::memcpy(address.salg_name, driver, std::strlen(driver) + 1);
+	bool const available = ::bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) == 0;
+	::close(fd);
+	return available;
+}
+
+inline std::uint64_t octeon_hash_pair(std::uint32_t high, std::uint32_t low)
+{
+	return (std::uint64_t(high) << 32) | low;
+}
+
+inline void octeon_write_state(std::uint64_t a, std::uint64_t b,
+	std::uint64_t c, std::uint64_t d)
+{
+	__asm__ volatile("dmtc2 %0,0x0048\n\tdmtc2 %1,0x0049\n\t"
+		"dmtc2 %2,0x004a\n\tdmtc2 %3,0x004b"
+		:: "d"(a), "d"(b), "d"(c), "d"(d) : "memory");
+}
+
+inline std::array<std::uint64_t, 4> octeon_read_state()
+{
+	std::array<std::uint64_t, 4> state;
+	__asm__ volatile("dmfc2 %0,0x0048\n\tdmfc2 %1,0x0049\n\t"
+		"dmfc2 %2,0x004a\n\tdmfc2 %3,0x004b"
+		: "=d"(state[0]), "=d"(state[1]), "=d"(state[2]), "=d"(state[3]) :: "memory");
+	return state;
+}
+
+template <bool Sha256>
+void octeon_compress(unsigned char const* data, std::size_t blocks)
+{
+	for (; blocks != 0; --blocks, data += SHA_CBLOCK)
+	{
+		std::uint64_t words[8];
+		std::memcpy(words, data, sizeof(words));
+		__asm__ volatile("dmtc2 %0,0x0040\n\tdmtc2 %1,0x0041\n\t"
+			"dmtc2 %2,0x0042\n\tdmtc2 %3,0x0043\n\t"
+			"dmtc2 %4,0x0044\n\tdmtc2 %5,0x0045\n\tdmtc2 %6,0x0046"
+			:: "d"(words[0]), "d"(words[1]), "d"(words[2]), "d"(words[3]),
+			   "d"(words[4]), "d"(words[5]), "d"(words[6]) : "memory");
+		if (Sha256)
+			__asm__ volatile("dmtc2 %0,0x404f" :: "d"(words[7]) : "memory");
+		else
+			__asm__ volatile("dmtc2 %0,0x4057" :: "d"(words[7]) : "memory");
+	}
+}
+
+inline void octeon_sha1_blocks(SHA_CTX& ctx, unsigned char const* data, std::size_t blocks)
+{
+	octeon_write_state(octeon_hash_pair(ctx.h0, ctx.h1), octeon_hash_pair(ctx.h2, ctx.h3),
+		octeon_hash_pair(ctx.h4, 0), 0);
+	octeon_compress<false>(data, blocks);
+	auto const state = octeon_read_state();
+	ctx.h0 = static_cast<std::uint32_t>(state[0] >> 32);
+	ctx.h1 = static_cast<std::uint32_t>(state[0]);
+	ctx.h2 = static_cast<std::uint32_t>(state[1] >> 32);
+	ctx.h3 = static_cast<std::uint32_t>(state[1]);
+	ctx.h4 = static_cast<std::uint32_t>(state[2] >> 32);
+}
+
+inline void octeon_sha256_blocks(SHA256_CTX& ctx, unsigned char const* data, std::size_t blocks)
+{
+	octeon_write_state(octeon_hash_pair(ctx.h[0], ctx.h[1]), octeon_hash_pair(ctx.h[2], ctx.h[3]),
+		octeon_hash_pair(ctx.h[4], ctx.h[5]), octeon_hash_pair(ctx.h[6], ctx.h[7]));
+	octeon_compress<true>(data, blocks);
+	auto const state = octeon_read_state();
+	for (unsigned int i = 0; i < state.size(); ++i)
+	{
+		ctx.h[2 * i] = static_cast<std::uint32_t>(state[i] >> 32);
+		ctx.h[2 * i + 1] = static_cast<std::uint32_t>(state[i]);
+	}
+}
+
+template <typename Context, typename Init, typename Update, typename Final, typename Compress>
+bool octeon_sha_selftest(char const* driver, Init init, Update update, Final final,
+	Compress compress, std::size_t digest_size)
+{
+	if (!octeon_driver_available(driver)) return false;
+	Context hw, sw;
+	std::array<unsigned char, 143> input;
+	std::array<unsigned char, SHA256_DIGEST_LENGTH> actual, expected;
+	for (std::size_t i = 0; i < input.size(); ++i)
+		input[i] = static_cast<unsigned char>(i * 7 + 11);
+
+	return init(&sw) && update(&sw, input.data(), input.size()) && final(expected.data(), &sw)
+		&& init(&hw) && update(&hw, input.data(), 5)
+		&& sha_update_blocks(hw, input.data() + 5, input.size() - 5, update, compress)
+		&& final(actual.data(), &hw)
+		&& std::memcmp(actual.data(), expected.data(), digest_size) == 0;
+}
+
+inline int octeon_sha1_update(SHA_CTX* ctx, unsigned char const* data, std::size_t size)
+{
+	static bool const enabled = octeon_sha_selftest<SHA_CTX>("octeon-sha1",
+		SHA1_Init, SHA1_Update, SHA1_Final, octeon_sha1_blocks, SHA_DIGEST_LENGTH);
+	if (!enabled) return SHA1_Update(ctx, data, size);
+	return sha_update_blocks(*ctx, data, size, SHA1_Update, octeon_sha1_blocks);
+}
+
+inline int octeon_sha256_update(SHA256_CTX* ctx, unsigned char const* data, std::size_t size)
+{
+	static bool const enabled = octeon_sha_selftest<SHA256_CTX>("octeon-sha256",
+		SHA256_Init, SHA256_Update, SHA256_Final, octeon_sha256_blocks, SHA256_DIGEST_LENGTH);
+	if (!enabled) return SHA256_Update(ctx, data, size);
+	return sha_update_blocks(*ctx, data, size, SHA256_Update, octeon_sha256_blocks);
+}
+#else
+inline int octeon_sha1_update(SHA_CTX* ctx, unsigned char const* data, std::size_t size)
+{
+	return SHA1_Update(ctx, data, size);
+}
+
+inline int octeon_sha256_update(SHA256_CTX* ctx, unsigned char const* data, std::size_t size)
+{
+	return SHA256_Update(ctx, data, size);
+}
+#endif
+}} // namespace libtorrent::aux
+
+#endif
