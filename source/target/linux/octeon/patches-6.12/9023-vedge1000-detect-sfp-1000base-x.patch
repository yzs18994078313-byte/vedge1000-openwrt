+static bool cvmx_helper_sgmii_is_1000x_word(u16 word)
+{
+	const u16 allowed = LPA_1000XFULL | LPA_1000XHALF | LPA_1000XPAUSE |
+			    LPA_1000XPAUSE_ASYM | LPA_LPACK | LPA_NPAGE |
+			    LPA_SGMII;
+
+	/* The 1000BASE-X duplex capability bits are reserved in SGMII. */
+	return (word & LPA_1000XFULL) && !(word & ~allowed);
+}
+
+u16 cvmx_helper_sgmii_1000x_partner(int ipd_port)
+{
+	int interface = cvmx_helper_get_interface_num(ipd_port);
+	int index = cvmx_helper_get_interface_index_num(ipd_port);
+	union cvmx_pcsx_rxx_sync_reg sync;
+	u16 partner;
+
+	if (cvmx_helper_get_1000x_mode(interface, index))
+		return 0;
+
+	sync.u64 = cvmx_read_csr(CVMX_PCSX_RXX_SYNC_REG(index, interface));
+	if (!sync.s.sync || !sync.s.bit_lock)
+		return 0;
+
+	partner = cvmx_read_csr(CVMX_PCSX_SGMX_LP_ADV_REG(index, interface));
+	return cvmx_helper_sgmii_is_1000x_word(partner) ? partner : 0;
+}
+EXPORT_SYMBOL_GPL(cvmx_helper_sgmii_1000x_partner);
+
+void cvmx_helper_sgmii_set_inband_1000x(int ipd_port, bool enable)
+{
+	int interface = cvmx_helper_get_interface_num(ipd_port);
+	int index = cvmx_helper_get_interface_index_num(ipd_port);
+	union cvmx_pcsx_miscx_ctl_reg misc;
+	union cvmx_gmxx_prtx_cfg gmx;
+	bool enabled;
+
+	if (cvmx_helper_get_1000x_mode(interface, index) == enable)
+		return;
+
+	misc.u64 = cvmx_read_csr(CVMX_PCSX_MISCX_CTL_REG(index, interface));
+	misc.s.gmxeno = 1;
+	cvmx_write_csr(CVMX_PCSX_MISCX_CTL_REG(index, interface), misc.u64);
+	gmx.u64 = cvmx_read_csr(CVMX_GMXX_PRTX_CFG(index, interface));
+	enabled = gmx.s.en;
+
+	cvmx_helper_set_1000x_mode(interface, index, enable);
+	__cvmx_helper_sgmii_hardware_init_one_time(interface, index);
+	cvmx_helper_sgmii_restart_inband(ipd_port, true);
+
+	/* The mode setup disables GMX. Preserve the port's admin state. */
+	gmx.u64 = cvmx_read_csr(CVMX_GMXX_PRTX_CFG(index, interface));
+	gmx.s.en = enabled;
+	cvmx_write_csr(CVMX_GMXX_PRTX_CFG(index, interface), gmx.u64);
+}
+EXPORT_SYMBOL_GPL(cvmx_helper_sgmii_set_inband_1000x);
