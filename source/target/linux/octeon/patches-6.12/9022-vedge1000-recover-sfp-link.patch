+	if (priv->sfp_an_attempts == N821_SFP_AN_ATTEMPTS) {
+		cvmx_helper_sgmii_report_inband(priv->port, priv->netdev->name);
+		priv->sfp_an_retry_at = 0;
+		return;
+	}
+	cvmx_helper_sgmii_restart_inband(priv->port, priv->sfp_an_attempts != 0);
+	priv->sfp_an_attempts++;
+	priv->sfp_an_retry_at = jiffies + 2 * HZ;
