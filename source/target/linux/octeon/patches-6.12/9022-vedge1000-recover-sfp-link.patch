+static void cvm_oct_recover_sfp(struct octeon_ethernet *priv)
+{
+	if (!priv->sfp_an_retry_at)
+		return;
+	if (netif_carrier_ok(priv->netdev)) {
+		priv->sfp_an_retry_at = 0;
+		return;
