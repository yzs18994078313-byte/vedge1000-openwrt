+static int cvm_oct_read_sfp_id(struct i2c_adapter *adapter,
+			       struct sfp_eeprom_base *id)
+{
+	u8 *bytes = (u8 *)id;
+	u8 offset, sum = 0;
+	size_t i;
+	int ret;
+
+	/* The N821 I2C controller accepts at most three bytes per message. */
+	for (offset = 0; offset < sizeof(*id); offset += 2) {
+		struct i2c_msg msgs[] = {
+			{ .addr = N821_SFP_EEPROM_ADDR, .len = 1, .buf = &offset },
+			{ .addr = N821_SFP_EEPROM_ADDR, .flags = I2C_M_RD,
+			  .len = 2, .buf = bytes + offset },
+		};
+
+		ret = i2c_transfer(adapter, msgs, ARRAY_SIZE(msgs));
+		if (ret != 2)
+			return ret < 0 ? ret : -EIO;
+	}
+	for (i = 0; i < offsetof(struct sfp_eeprom_base, cc_base); i++)
+		sum += bytes[i];
+
+	return sum == id->cc_base ? 0 : -EBADMSG;
+}
+
+static bool cvm_oct_sfp_id_matches(const char field[16], const char *expected)
+{
+	size_t len = 16;
+
+	while (len && (field[len - 1] == ' ' || field[len - 1] == '\0'))
+		len--;
+
+	return len == strlen(expected) && !memcmp(field, expected, len);
+}
+
+static void cvm_oct_preselect_sfp_mode(struct octeon_ethernet *priv)
+{
+	struct sfp_eeprom_base id;
+	struct i2c_adapter *adapter;
+	struct device_node *bus;
+	int ret;
+
+	if (!IS_REACHABLE(CONFIG_I2C) || !priv->sfp_eeprom_tries)
+		return;
+	if (netif_carrier_ok(priv->netdev)) {
+		priv->sfp_eeprom_tries = 0;
+		return;
+	}
+
+	bus = of_parse_phandle(priv->of_node, "cisco,sfp-i2c-bus", 0);
+	if (!bus) {
+		priv->sfp_eeprom_tries = 0;
+		return;
+	}
+	adapter = of_get_i2c_adapter_by_node(bus);
+	of_node_put(bus);
+	if (!adapter)
+		return;
+
+	priv->sfp_eeprom_tries--;
+	ret = cvm_oct_read_sfp_id(adapter, &id);
+	i2c_put_adapter(adapter);
+	if (ret)
+		return;
+	priv->sfp_eeprom_tries = 0;
+
+	/* This module's host side uses Clause 37, even though it is RJ45. */
+	if (id.phys_id != SFF8024_ID_SFP ||
+	    !cvm_oct_sfp_id_matches(id.vendor_name, "OEM") ||
+	    !cvm_oct_sfp_id_matches(id.vendor_pn, "SFP-GE-T"))
+		return;
+
+	cvmx_helper_sgmii_set_inband_1000x(priv->port, true);
+	priv->sfp_an_attempts = 0;
+	priv->sfp_an_retry_at = priv->sfp_active ? jiffies + HZ : 0;
+	netdev_info(priv->netdev, "SFP EEPROM OEM SFP-GE-T: preselected 1000BASE-X\n");
+}
