+static union cvmx_helper_link_info cvmx_helper_sgmii_read_partner(int interface,
+								  int index)
+{
+	union cvmx_helper_link_info result = { .u64 = 0 };
+	union cvmx_pcsx_mrx_status_reg status;
+	union cvmx_pcsx_sgmx_lp_adv_reg partner;
+
+	/* The link bit is latched low until the first read. */
+	cvmx_read_csr(CVMX_PCSX_MRX_STATUS_REG(index, interface));
+	status.u64 = cvmx_read_csr(CVMX_PCSX_MRX_STATUS_REG(index, interface));
+	if (!status.s.lnk_st || !status.s.an_cpt)
+		return result;
+
+	/* In MAC mode the module advertises its link, speed and duplex. */
+	partner.u64 = cvmx_read_csr(CVMX_PCSX_SGMX_LP_ADV_REG(index, interface));
+	if (!partner.s.one || !partner.s.link)
+		return result;
+
+	switch (partner.s.speed) {
+	case 0:
+		result.s.speed = 10;
+		break;
+	case 1:
+		result.s.speed = 100;
+		break;
+	case 2:
+		result.s.speed = 1000;
+		break;
+	default:
+		return result;
+	}
+	result.s.full_duplex = partner.s.dup;
+	result.s.link_up = 1;
+	return result;
+}
