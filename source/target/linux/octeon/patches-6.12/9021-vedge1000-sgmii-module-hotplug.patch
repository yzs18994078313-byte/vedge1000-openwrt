+static void cvm_oct_poll_sfp(struct octeon_ethernet *priv)
+{
+	struct net_device *dev = priv->netdev;
+	struct gpio_desc *mod_def0 = priv->sfp_mod_def0;
+	int old_state = priv->sfp_mod_def0_state;
+	int state;
+
+	if (IS_ERR(mod_def0)) {
+		/* The CPLD GPIO provider is loaded after this built-in driver. */
+		mod_def0 = fwnode_gpiod_get_index(of_fwnode_handle(priv->of_node),
+						 "mod-def0", 0, GPIOD_IN,
+						 dev->name);
+		if (IS_ERR(mod_def0)) {
+			if (PTR_ERR(mod_def0) != -EPROBE_DEFER) {
+				netdev_warn(dev, "SFP presence GPIO unavailable: %ld\n",
+					    PTR_ERR(mod_def0));
+				priv->sfp_mod_def0 = NULL;
+			}
+			return;
+		}
+		priv->sfp_mod_def0 = mod_def0;
+	}
+
+	/* Either edge invalidates the old PCS state. */
+	state = gpiod_get_raw_value_cansleep(mod_def0);
+	if (state < 0 || state == old_state)
+		return;
+	priv->sfp_mod_def0_state = state;
+
+	/* Preserve a working cold-boot link when the GPIO first becomes ready. */
+	if (old_state < 0 && cvmx_helper_link_get(priv->port).s.link_up)
+		return;
+	if (old_state >= 0)
+		netdev_info(dev, "SFP cage signal %d -> %d, restarting SGMII\n",
+			    old_state, state);
+
+	priv->link_info = 0;
+	netif_carrier_off(dev);
+	cvmx_helper_sgmii_restart_inband(priv->port);
+}
