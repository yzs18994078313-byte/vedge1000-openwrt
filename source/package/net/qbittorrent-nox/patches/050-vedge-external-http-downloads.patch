+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+    constexpr int DIR_FLAGS = O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC;
+    constexpr int FILE_FLAGS = O_RDONLY | O_NONBLOCK | O_NOFOLLOW | O_CLOEXEC;
+    constexpr int PAGE_SIZE = 256;
+
+    class Descriptor
+    {
+    public:
+        explicit Descriptor(const int fd = -1) : m_fd(fd) {}
+        ~Descriptor() { reset(); }
+        Descriptor(Descriptor &&other) noexcept : m_fd(other.release()) {}
+        Descriptor(const Descriptor &) = delete;
+        Descriptor &operator=(const Descriptor &) = delete;
+        int get() const { return m_fd; }
+        int release() { return std::exchange(m_fd, -1); }
+        void reset(const int fd = -1)
+        {
+            if (m_fd >= 0)
+                ::close(m_fd);
+            m_fd = fd;
+        }
+
+    private:
+        int m_fd;
+    };
+
+    struct Volume
+    {
+        QString path;
+        QByteArray device;
+    };
+
+    QByteArray mountPath(QByteArray field)
+    {
+        return field.replace("\\040", " ").replace("\\011", "\t")
+            .replace("\\012", "\n").replace("\\134", "\\");
+    }
+
+    QString diskPath(const QByteArray &device)
+    {
+        const QString path = QFileInfo(u"/sys/dev/block/"_s + QString::fromLatin1(device)).canonicalFilePath();
+        if (!path.isEmpty() && QFileInfo::exists(path + u"/partition"))
+            return QFileInfo(path).path();
+        return path;
+    }
+
+    QList<Volume> mountedVolumes()
+    {
+        QFile mounts(u"/proc/self/mountinfo"_s);
+        QList<Volume> candidates;
+        QSet<QString> systemDisks;
+        if (!mounts.open(QIODevice::ReadOnly))
+            return candidates;
+
+        for (QByteArray line = mounts.readLine(); !line.isEmpty(); line = mounts.readLine())
+        {
+            const auto fields = line.split(' ');
+            if (fields.size() < 7)
+                continue;
+            const QByteArray path = mountPath(fields[4]);
+            if ((path == "/") || (path == "/rom") || (path == "/overlay") || (path == "/boot"))
+                systemDisks.insert(diskPath(fields[2]));
+            if ((fields[3] == "/") && ((path == "/mnt") || path.startsWith("/mnt/")))
+            {
+                const QString decoded = QFile::decodeName(path);
+                if (QFile::encodeName(decoded) == path)
+                    candidates.append({decoded, fields[2]});
+            }
+        }
+
+        static const QRegularExpression usbPath(u"/usb[0-9]+/.+/block/"_s);
+        QList<Volume> volumes;
+        for (const auto &volume : candidates)
+        {
+            const QString disk = diskPath(volume.device);
+            if (usbPath.match(disk).hasMatch() && !disk.contains(u"/16f0000000000.ehci/")
+                && !systemDisks.contains(disk))
+            {
+                volumes.append(volume);
+            }
+        }
+        return volumes;
+    }
+
+    QByteArray deviceNumber(const dev_t device)
+    {
+        return QByteArray::number(major(device)) + ':' + QByteArray::number(minor(device));
+    }
+
+    Descriptor openPath(Descriptor directory, const QString &path, const int lastFlags,
+        const QByteArray &requiredDevice = {})
+    {
+        if (directory.get() < 0)
+            throw NotFoundHTTPError();
+        if (path.isEmpty())
+            return directory;
+
+        const auto parts = path.split(u'/');
+        for (qsizetype index = 0; index < parts.size(); ++index)
+        {
+            const QString &part = parts[index];
+            if (part.isEmpty() || (part == u".") || (part == u"..") || part.contains(QChar::Null))
+                throw BadRequestHTTPError();
+
+            const QByteArray name = QFile::encodeName(part);
+            const int flags = (index == (parts.size() - 1)) ? lastFlags : DIR_FLAGS;
+            directory.reset(::openat(directory.get(), name.constData(), flags));
+            struct stat info {};
+            if ((directory.get() < 0) || (::fstat(directory.get(), &info) < 0)
+                || (!requiredDevice.isEmpty() && (deviceNumber(info.st_dev) != requiredDevice)))
+            {
+                throw NotFoundHTTPError();
+            }
+        }
+        return directory;
+    }
+
+    Descriptor openVolume(const Volume &volume)
+    {
+        const QString relative = (volume.path == u"/mnt") ? QString{} : volume.path.sliced(5);
+        auto directory = openPath(Descriptor(::open("/mnt", DIR_FLAGS)), relative, DIR_FLAGS);
+        struct stat info {};
+        if ((::fstat(directory.get(), &info) < 0) || (deviceNumber(info.st_dev) != volume.device))
+            throw NotFoundHTTPError();
+        return directory;
+    }
+
+    QJsonObject listDirectory(const Volume &volume, const QString &path, const int offset)
+    {
+        auto fd = openPath(openVolume(volume), path, DIR_FLAGS, volume.device);
+        std::unique_ptr<DIR, decltype(&::closedir)> dir(::fdopendir(fd.get()), &::closedir);
+        if (!dir)
+            throw NotFoundHTTPError();
+        fd.release();
+
+        QJsonArray files;
+        bool more = false;
+        int remaining = offset;
+        while (const auto *entry = ::readdir(dir.get()))
+        {
+            const QByteArray name(entry->d_name);
+            if ((name == ".") || (name == ".."))
+                continue;
+            const QString decoded = QFile::decodeName(name);
+            if (QFile::encodeName(decoded) != name)
+                continue;
+            struct stat info {};
+            const int dirFd = ::dirfd(dir.get());
+            if ((::fstatat(dirFd, name.constData(), &info, AT_SYMLINK_NOFOLLOW) < 0)
+                || (deviceNumber(info.st_dev) != volume.device)
+                || (!S_ISDIR(info.st_mode) && !S_ISREG(info.st_mode))
+                || (::faccessat(dirFd, name.constData(), S_ISDIR(info.st_mode) ? (R_OK | X_OK) : R_OK, 0) < 0))
+            {
+                continue;
+            }
+            if (remaining > 0)
+            {
+                --remaining;
+                continue;
+            }
+            if (files.size() == PAGE_SIZE)
+            {
+                more = true;
+                break;
+            }
+            files.append(QJsonObject {{u"name"_s, decoded}, {u"directory"_s, S_ISDIR(info.st_mode) != 0},
+                {u"size"_s, static_cast<qint64>(info.st_size)}});
+        }
+        return {{u"files"_s, files}, {u"nextOffset"_s, more ? (offset + PAGE_SIZE) : -1}};
+    }
+
+    void download(const Volume &volume, const QString &path,
+        Http::HeaderMap headers, Http::ResponseWriter &writer)
+    {
+        if (path.isEmpty())
+            throw BadRequestHTTPError();
+
+        auto fd = openPath(openVolume(volume), path, FILE_FLAGS, volume.device);
+        struct stat info {};
+        if ((::fstat(fd.get(), &info) < 0) || !S_ISREG(info.st_mode))
+            throw NotFoundHTTPError();
+
+        ::posix_fadvise(fd.get(), 0, 0, POSIX_FADV_SEQUENTIAL);
+        auto file = std::make_shared<QFile>();
+        if (!file->open(fd.get(), QIODevice::ReadOnly | QIODevice::Unbuffered, QFileDevice::AutoCloseHandle))
+            throw NotFoundHTTPError();
+        fd.release();
+
+        const QString name = path.sliced(path.lastIndexOf(u'/') + 1);
+        headers.insert(Http::HEADER_CONTENT_TYPE, u"application/octet-stream"_s);
+        headers.insert(Http::HEADER_CONTENT_DISPOSITION, u"attachment; filename=\"download\"; filename*=UTF-8''"_s
+            + QString::fromLatin1(QUrl::toPercentEncoding(name)));
+        headers.insert(Http::HEADER_CACHE_CONTROL, u"private, no-store"_s);
+        writer.streamFile(Path(name), headers, std::move(file));
+    }
+}
+
+void ExternalDownloads::process(const QString &action, const Http::Request &request,
+    const Http::HeaderMap &commonHeaders, Http::ResponseWriter &writer)
+{
+    if ((request.method != Http::HEADER_REQUEST_METHOD_GET) && (request.method != Http::HEADER_REQUEST_METHOD_HEAD))
+        throw MethodNotAllowedHTTPError();
+
+    const QString volumePath = QString::fromUtf8(request.query.value(u"volume"_s));
+    const QString path = QString::fromUtf8(request.query.value(u"path"_s));
+    const auto volumes = mountedVolumes();
+    if (action == u"volumes")
+    {
+        QJsonArray result;
+        for (const auto &volume : volumes)
+        {
+            try
+            {
+                openVolume(volume);
+                result.append(volume.path);
+            }
+            catch (const NotFoundHTTPError &)
+            {
+            }
+        }
+        Http::Response response {.status = {.code = 200}, .headers = commonHeaders,
+            .content = QJsonDocument(result).toJson(QJsonDocument::Compact)};
+        response.headers.insert(Http::HEADER_CONTENT_TYPE, u"application/json"_s);
+        response.headers.insert(Http::HEADER_CACHE_CONTROL, u"private, no-store"_s);
+        writer.setResponse(response);
+        return;
+    }
+
+    for (const auto &volume : volumes)
+    {
+        if (volume.path != volumePath)
+            continue;
+        if (action == u"download")
+        {
+            download(volume, path, commonHeaders, writer);
+            return;
+        }
+        if (action == u"list")
+        {
+            bool validOffset = false;
+            const int offset = request.query.value(u"offset"_s, "0").toInt(&validOffset);
+            if (!validOffset || (offset < 0) || (offset > 1000000))
+                throw BadRequestHTTPError();
+            const auto result = listDirectory(volume, path, offset);
+            Http::Response response {.status = {.code = 200}, .headers = commonHeaders,
+                .content = QJsonDocument(result).toJson(QJsonDocument::Compact)};
+            response.headers.insert(Http::HEADER_CONTENT_TYPE, u"application/json"_s);
+            response.headers.insert(Http::HEADER_CACHE_CONTROL, u"private, no-store"_s);
+            writer.setResponse(response);
+            return;
+        }
+    }
+    throw NotFoundHTTPError();
+}
