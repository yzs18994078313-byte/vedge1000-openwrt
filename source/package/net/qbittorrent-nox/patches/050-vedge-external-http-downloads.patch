+"use strict";
+
+const byId = (id) => document.getElementById(id);
+const volume = byId("volume");
+const status = byId("status");
+const table = byId("files");
+const entries = byId("entries");
+const pages = byId("pages");
+const parent = byId("parent");
+const previous = byId("previous");
+const next = byId("next");
+let path = [];
+let pageOffsets = [0];
+let nextOffset = -1;
+let generation = 0;
+
+function endpoint(action, parameters = {}) {
+    return "api/v2/externalDownloads/" + action + "?" + new URLSearchParams(parameters);
+}
+
+async function get(action, parameters) {
+    const response = await fetch(endpoint(action, parameters), { cache: "no-store" });
+    if (response.status === 403)
+        throw new Error("登录已失效，请返回 qBittorrent 登录。");
+    if (!response.ok)
+        throw new Error("无法读取目录。请确认外置盘仍然挂载并且文件可读。");
+    return response.json();
+}
+
+function sizeText(size) {
+    if (size < 1024)
+        return size + " B";
+    const units = ["KiB", "MiB", "GiB", "TiB"];
+    let power = 0;
+    while ((size >= (1024 * 1024)) && (power < (units.length - 1))) {
+        size /= 1024;
+        ++power;
+    }
+    return (size / 1024).toFixed(1) + " " + units[power];
+}
+
+function row(file) {
+    const item = document.createElement("tr");
+    const name = item.insertCell();
+    const size = item.insertCell();
+    const action = item.insertCell();
+    if (file.directory) {
+        const button = document.createElement("button");
+        button.type = "button";
+        button.textContent = file.name + "/";
+        button.addEventListener("click", () => navigate([...path, file.name]));
+        name.append(button);
+    }
+    else {
+        name.textContent = file.name;
+        size.textContent = sizeText(file.size);
+        const link = document.createElement("a");
+        link.textContent = "下载";
+        link.href = endpoint("download", { volume: volume.value, path: [...path, file.name].join("/") });
+        action.append(link);
+    }
+    return item;
+}
+
+async function load() {
+    const request = ++generation;
+    parent.disabled = path.length === 0;
+    byId("path").textContent = "/" + path.join("/");
+    table.hidden = true;
+    pages.hidden = true;
+    if (!volume.value) {
+        status.textContent = "未找到可读的外置盘。";
+        return;
+    }
+    status.textContent = "正在读取目录…";
+    try {
+        const data = await get("list", { volume: volume.value, path: path.join("/"), offset: pageOffsets.at(-1) });
+        if (request !== generation)
+            return;
+        entries.replaceChildren(...data.files.map(row));
+        table.hidden = data.files.length === 0;
+        status.textContent = data.files.length ? "" : "此目录没有可读文件。";
+        nextOffset = data.nextOffset;
+        previous.disabled = pageOffsets.length === 1;
+        next.disabled = nextOffset < 0;
+        pages.hidden = previous.disabled && next.disabled;
+    }
+    catch (error) {
+        if (request === generation)
+            status.textContent = error.message;
+    }
+}
+
+function navigate(parts) {
+    path = parts;
+    pageOffsets = [0];
+    load();
+}
+
+async function refresh() {
+    const request = ++generation;
+    const selected = volume.value;
+    table.hidden = true;
+    pages.hidden = true;
+    status.textContent = "正在查找外置盘…";
+    try {
+        const volumes = await get("volumes");
+        if (request !== generation)
+            return;
+        volume.replaceChildren(...volumes.map((mount) => new Option(mount, mount)));
+        if (volumes.includes(selected))
+            volume.value = selected;
+        navigate(volumes.includes(selected) ? path : []);
+    }
+    catch (error) {
+        if (request === generation)
+            status.textContent = error.message;
+    }
+}
+
+byId("refresh").addEventListener("click", refresh);
+volume.addEventListener("change", () => navigate([]));
+parent.addEventListener("click", () => navigate(path.slice(0, -1)));
+previous.addEventListener("click", () => {
+    pageOffsets.pop();
+    load();
+});
+next.addEventListener("click", () => {
+    pageOffsets.push(nextOffset);
+    load();
+});
+refresh();
