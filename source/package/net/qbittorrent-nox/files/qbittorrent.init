#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

start_service() {
	local enabled port
	local profile=/etc/qBittorrent
	local logs=/var/log/qbittorrent

	config_load qbittorrent
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get port config http_port 8080
	case "$port" in
		''|*[!0-9]*)
			echo "qbittorrent: invalid http_port" >&2
			return 1
			;;
	esac
	if ! [ "$port" -ge 1024 ] || ! [ "$port" -le 65535 ]; then
		echo "qbittorrent: http_port must be between 1024 and 65535" >&2
		return 1
	fi

	[ ! -L "$profile" ] && [ ! -L "$logs" ] && mkdir -p "$profile" "$logs" &&
		chmod 0750 "$profile" "$logs" && chown qbittorrent:qbittorrent "$profile" "$logs" || return 1
	procd_open_instance
	procd_set_param command /usr/libexec/qbittorrent-start "$port" '*'
	procd_set_param user qbittorrent
	procd_set_param group qbittorrent
	procd_set_param env HOME="$profile"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 3
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger qbittorrent
	procd_add_reload_interface_trigger lan
}
